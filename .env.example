# Copie este arquivo para ".env" e preencha com sua chave real.
# NUNCA suba o arquivo ".env" real para o GitHub (adicione ao .gitignore).
#
# Gere sua chave gratuita em: https://aistudio.google.com/apikey
# (não pede cartão de crédito — camada gratuita permanente para os modelos Flash/Flash-Lite)

GOOGLE_API_KEY=sua_chave_aqui

